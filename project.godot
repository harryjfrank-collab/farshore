; Engine configuration file.
; Godot adds config/features for your editor version the first time it opens this project.

config_version=5

[application]

config/name="Farshore"
config/description="Cozy co-op sandbox on a distant shore."
run/main_scene="res://scenes/main.tscn"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Permissions="*res://scripts/autoload/permissions.gd"
WorldClock="*res://scripts/autoload/world_clock.gd"

[rendering]

anti_aliasing/quality/msaa_3d=2
